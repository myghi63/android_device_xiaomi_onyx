// media_product.mk always packages the 'webview' module. The Lineage Chromium
// prebuilt projects are dropped from this build (remove-project entries in the
// local manifest), so the module is provided here: the GrapheneOS Vanadium
// WebView import from external/vanadium (package app.vanadium.webview,
// accepted by the FrameworkOverlayOnyx override of config_webview_packages.xml).
// VanadiumConfig is installed through 'required'.
android_app_import {
    name: "webview",
    product_specific: true,

    optional_uses_libs: [
        "android.test.base",
        "androidx.window.extensions",
        "android.ext.adservices",
    ],

    required: [
        "VanadiumConfig",
    ],

    apk: "VanadiumWebView.apk",

    // The apk is already aligned and signed by GrapheneOS; the .idsig stays
    // unused for system partitions (dm-verity covers /product).
    preprocessed: true,
}
