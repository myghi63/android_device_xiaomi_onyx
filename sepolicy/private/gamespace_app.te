# GameSpace (io.chaldeaprjkt.gamespace): privileged system app carrying the
# game overlay, the mi_thermald scene engine and the MCA bypass-charging
# arbitration. Carve-outs mirror the validated onyx_bypass_app domain, which
# shares the same Settings keys and nodes while it is phased out.

type gamespace_app, domain, coredomain;
typeattribute gamespace_app mlstrustedsubject;

app_domain(gamespace_app)

# Service lookups. GameSpace (and the vendored axion platform client) reach a
# wide set of system services; upstream crDroid gets these implicitly because
# GameSpace runs as system_app. system_app's blanket find cannot be mirrored
# here: service_manager_type covers every HAL, and each HAL has a neverallow
# only registered client domains satisfy - the blanket cost 144 neverallow
# failures. Carry an explicit list instead: the rules that already worked in
# the field plus the services proven by the enforced and permissive test runs
# (wifi, bluetooth_manager, tethering, netpolicy, nfc, color_display, game,
# radio, telephony.registry, sensor_privacy, vibrator_manager, deviceidle).
# color_display is load-bearing: its lookup throws, and a crash-looping
# uid-system service triggers RescueParty and reboots the phone.
# media_session is load-bearing the other way: PhoneWindow dispatches every
# volume key through MediaSessionManager, whose lookup uses getService (no
# throw) - a denial caches a null binder and the first volume press NPEs the
# settings activity, silently (user builds audit nothing). system_app carries
# this via its near-blanket service_manager_type find (minus native-daemon
# exclusions); the dedicated domain must carry it explicitly.
allow gamespace_app servicemanager:service_manager list;
allow gamespace_app {
  activity_service
  activity_task_service
  app_function_service
  audio_service
  autofill_service
  bluetooth_manager_service
  color_display_service
  content_capture_service
  deviceidle_service
  display_service
  game_service
  gpu_service
  hint_service
  media_session_service
  netpolicy_service
  netstats_service
  nfc_service
  notification_service
  power_service
  protolog_configuration_service
  radio_service
  registry_service
  sensor_privacy_service
  sensitive_content_protection_service
  tethering_service
  thermal_service
  uimode_service
  vibrator_manager_service
  voiceinteraction_service
  wifi_service
}:service_manager find;

allow gamespace_app system_app_data_file:dir create_dir_perms;
allow gamespace_app system_app_data_file:file create_file_perms;
allow gamespace_app system_app_data_file:lnk_file create_file_perms;

# Cgroup migration: libcutils set_sched_policy/set_cpuset_policy writes
# /dev/cpuctl/* and /dev/cpuset/* from the app process itself (framework
# scheduling, not GameSpace code). domain.te excludes appdomain from the
# generic cgroup rules, so carry the private/system_app.te set plus the v1
# dir search those paths need.
allow gamespace_app cgroup:dir r_dir_perms;
allow gamespace_app cgroup:file w_file_perms;
allow gamespace_app cgroup_v2:file w_file_perms;
allow gamespace_app cgroup_v2:dir w_dir_perms;

# Thermal scenes: write sconfig (/sys/devices/virtual/thermal/...)
allow gamespace_app sysfs_thermal:dir r_dir_perms;
allow gamespace_app sysfs_thermal:file w_file_perms;

# Bypass charging: charge_enable client arbitration node (MCA charger)
allow gamespace_app vendor_sysfs_xm_power:dir r_dir_perms;
allow gamespace_app vendor_sysfs_xm_power:file rw_file_perms;
