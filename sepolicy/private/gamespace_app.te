# GameSpace (io.chaldeaprjkt.gamespace): privileged system app carrying the
# game overlay, the mi_thermald scene engine and the MCA bypass-charging
# arbitration. Carve-outs mirror the validated onyx_bypass_app domain, which
# shares the same Settings keys and nodes while it is phased out.

type gamespace_app, domain, coredomain;
typeattribute gamespace_app mlstrustedsubject;

app_domain(gamespace_app)

# Foreground detection (TaskStackListener + focusedRootTaskInfo) and the
# settings pages' UI. GameManager needs no find rule: GameManagerService is
# not a service_manager service in policy at all (same as upstream crDroid,
# which ships GameSpace with zero sepolicy additions).
allow gamespace_app activity_service:service_manager find;
allow gamespace_app activity_task_service:service_manager find;
allow gamespace_app audio_service:service_manager find;
allow gamespace_app gpu_service:service_manager find;
allow gamespace_app netstats_service:service_manager find;

# Notices (Toast) go through the notification service, and the toast path resolves
# the display through the display service.
allow gamespace_app notification_service:service_manager find;
allow gamespace_app display_service:service_manager find;

# The screen state comes from PowerManager, whose lookup resolves both the power and
# the thermal service. Without them the lookup yields null and neither the game scene
# nor the bypass request is ever applied.
allow gamespace_app power_service:service_manager find;
allow gamespace_app thermal_service:service_manager find;

# Service lookups every UI process makes: ActivityThread/ViewRootImpl resolve these
# when an activity is created, and a denied find just nulls the manager behind it.
allow gamespace_app app_function_service:service_manager find;
allow gamespace_app autofill_service:service_manager find;
allow gamespace_app content_capture_service:service_manager find;
allow gamespace_app hint_service:service_manager find;
allow gamespace_app protolog_configuration_service:service_manager find;
allow gamespace_app sensitive_content_protection_service:service_manager find;
allow gamespace_app uimode_service:service_manager find;
allow gamespace_app voiceinteraction_service:service_manager find;

allow gamespace_app system_app_data_file:dir create_dir_perms;
allow gamespace_app system_app_data_file:file create_file_perms;
allow gamespace_app system_app_data_file:lnk_file create_file_perms;

# Thermal scenes: write sconfig (/sys/devices/virtual/thermal/...)
allow gamespace_app sysfs_thermal:dir r_dir_perms;
allow gamespace_app sysfs_thermal:file w_file_perms;

# Bypass charging: charge_enable client arbitration node (MCA charger)
allow gamespace_app vendor_sysfs_xm_power:dir r_dir_perms;
allow gamespace_app vendor_sysfs_xm_power:file rw_file_perms;
