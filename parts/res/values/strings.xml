<resources>
    <!-- App Name -->
    <string name="app_name">Xiaomi Parts</string>

    <!-- Bypass charging (Settings > Battery entry title) -->
    <string name="bypass_charging_title">Bypass charging</string>
    <!-- Switch label in the bypass charging page -->
    <string name="bypass_gaming_title">Bypass while gaming</string>
    <!-- Explanation of what the switch does -->
    <string name="bypass_gaming_summary">Enabled by default. While an app from the game list is in the foreground, the adapter powers the device directly and the battery stops charging. Needs the device plugged in; refused below 20 %.</string>
    <!-- Switch label: force bypass whatever the foreground app is -->
    <string name="bypass_now_title">Bypass now</string>
    <!-- Explanation of the forced bypass switch -->
    <string name="bypass_now_summary">Enable bypass charging even when no app from the game list is running. Same conditions: plugged in and above 20 %. Switches itself off after a reboot.</string>
    <!-- Switch label: apply the gaming thermal scene to the game list -->
    <string name="thermal_gaming_title">Gaming thermal profile</string>
    <!-- Explanation of the gaming thermal profile switch -->
    <string name="thermal_gaming_summary">Apply the gaming thermal scene while an app from the game list is in the foreground. The scene also caps the charging current when the battery warms up: switch it off to keep the default scene while gaming, for example together with bypass charging.</string>
    <!-- Switch label: force the gaming thermal scene whatever the foreground app is -->
    <string name="thermal_now_title">Gaming thermal profile now</string>
    <!-- Explanation of the forced gaming thermal scene switch -->
    <string name="thermal_now_summary">Apply the gaming thermal scene even when no app from the game list is running. Switches itself off after a reboot.</string>
    <!-- Notice shown when bypass charging becomes active -->
    <string name="bypass_enabled_notice">Bypass charging enabled</string>
    <!-- Notice shown when bypass charging is refused, reason unknown -->
    <string name="bypass_refused">Bypass charging not enabled</string>
    <!-- Notice shown when bypass charging is refused: no adapter connected -->
    <string name="bypass_refused_not_plugged">Bypass charging not enabled: the device is not plugged in</string>
    <!-- Notice shown when bypass charging is refused: battery too low -->
    <string name="bypass_refused_battery">Bypass charging not enabled: battery at %1$d%% (minimum 20%%)</string>

    <!-- Game list page title -->
    <string name="game_list_title">Game list</string>
    <!-- Summary of the game list entry in the bypass charging page -->
    <string name="game_list_summary">Apps that get the gaming thermal scene and bypass charging.</string>
    <!-- Switch that lets the game flag populate the list -->
    <string name="game_list_auto_title">Add detected games</string>
    <!-- Explanation of the automatic game list switch -->
    <string name="game_list_auto_summary">Apps that declare themselves as games join the list on their own. Anything you take out of the list stays out.</string>
    <!-- Button opening the app picker of the game list -->
    <string name="game_list_add_title">Add apps</string>
    <!-- Summary of the app picker entry -->
    <string name="game_list_add_summary">Choose which apps join the list.</string>
    <!-- Title of the group listing the apps in the game list -->
    <string name="game_list_entries_title">In the list</string>
    <!-- Placeholder shown when the game list has no app -->
    <string name="game_list_empty">No apps in the list</string>
</resources>
