<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        android:key="gaming_category"
        android:title="@string/charge_section_gaming_title" >

        <SwitchPreferenceCompat
            android:key="onyx_bypass_gaming"
            android:title="@string/bypass_gaming_title"
            android:summary="@string/bypass_gaming_summary"
            android:persistent="false" />

        <SwitchPreferenceCompat
            android:key="onyx_thermal_gaming"
            android:title="@string/thermal_gaming_title"
            android:summary="@string/thermal_gaming_summary"
            android:persistent="false" />

        <Preference
            android:key="onyx_game_list_page"
            android:title="@string/game_list_title"
            android:summary="@string/game_list_summary"
            android:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="forced_category"
        android:title="@string/charge_section_forced_title" >

        <SwitchPreferenceCompat
            android:key="onyx_bypass_always"
            android:title="@string/bypass_now_title"
            android:summary="@string/bypass_now_summary"
            android:persistent="false" />

        <SwitchPreferenceCompat
            android:key="onyx_thermal_always"
            android:title="@string/thermal_now_title"
            android:summary="@string/thermal_now_summary"
            android:persistent="false" />

    </PreferenceCategory>

</PreferenceScreen>
